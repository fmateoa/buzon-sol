# Solo producción (Dockerfile.web): copiar a apps/web/.env.production en el servidor (ignorado por git).
# Sin secretos; se compila dentro de la imagen, así que cambiarlo exige reconstruir el contenedor `web`.
# Origen de la API, sin barra final ni /api/v1. Debe compartir dominio padre con la web (SameSite=Strict).
VITE_API_URL=https://api.buzon.example.com
