# Plantilla sin secretos reales. Para desarrollo local `node scripts/dev-env.mjs` genera apps/api/.env con valores aleatorios.
# API y worker leen las mismas variables de base de datos, Redis y S3; solo el worker necesita la clave privada.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=buzon_sol
DB_USER=buzon
DB_PASSWORD=

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# API (obligatorias al arrancar: ver apps/api/src/config.ts)
API_PORT=3000
SOL_KEY_ID=
SOL_PUBLIC_KEY_PEM=
ACCOUNT_FINGERPRINT_KEY_B64=
# SESSION_COOKIE_SECURE=true

# Worker (obligatorias si ENABLE_SUNAT_JOBS=true: ver apps/worker/src/config.ts). Nunca en la API de producción.
# SOL_PRIVATE_KEY_PEM=
# SOL_PREVIOUS_KEY_ID=
# SOL_PREVIOUS_PRIVATE_KEY_PEM=

# Almacenamiento S3 compatible, bucket privado (obligatorias con SUNAT_FILE_CLIENT_READY=true)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Puertas SUNAT: apagadas por defecto. Solo `true` explícito las activa y solo el operador, con la prueba del plan 02 superada.
# ENABLE_SUNAT_JOBS=
# SUNAT_CONNECTION_CLIENT_READY=
# SUNAT_TRANSPORT_VALIDATED=
# SUNAT_READ_VALIDATED=
# SUNAT_FILE_CLIENT_READY=
# SUNAT_CRON_VALIDATED=
# SUNAT_PASSIVE_START_VALIDATED=
