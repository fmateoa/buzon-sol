# Solo producción (compose.prod.yml): lo carga únicamente el contenedor del worker, después de apps/api/.env.
# Aquí va únicamente lo que la API no debe recibir: el material para abrir la Clave SOL.
# Las puertas SUNAT_* NO van aquí: la API también las lee y viven en apps/api/.env (el worker también lo carga).
# Obligatorias si ENABLE_SUNAT_JOBS=true (ver apps/worker/src/config.ts).
# SOL_PRIVATE_KEY_PEM=
# SOL_PREVIOUS_KEY_ID=
# SOL_PREVIOUS_PRIVATE_KEY_PEM=
